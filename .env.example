# Paths are optional. Defaults resolve from the repository root.
PODCAST_PIPELINE_HOME=
PODCAST_PIPELINE_CONFIG_DIR=
PODCAST_PIPELINE_OUTPUT_DIR=
PODCAST_PIPELINE_STATE_DIR=
PODCAST_PIPELINE_LOG_DIR=
PODCAST_PIPELINE_PYTHON=
PODCAST_PIPELINE_EXTRA_PATH=

# Set to off for direct networking, or provide an explicit proxy URL.
PODCAST_PIPELINE_PROXY=off
PODCAST_PIPELINE_ALL_PROXY=

# Optional Feishu credentials. Never commit real values.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=

# Optional OpenClaw runner override. The tracked policy currently uses main.
OPENCLAW_SHOW_NOTES_TRANSLATION_AGENT_ID=main
